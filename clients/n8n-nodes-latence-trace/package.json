{
  "name": "n8n-nodes-latence-trace",
  "version": "0.1.0",
  "description": "n8n community node for Latence TRACE: score groundedness and route RAG answers by risk band.",
  "keywords": [
    "n8n-community-node-package",
    "latence",
    "trace",
    "rag",
    "groundedness",
    "hallucination"
  ],
  "license": "Apache-2.0",
  "homepage": "https://latence.ai",
  "author": {
    "name": "Latence",
    "email": "support@latence.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latence-ai/latence-trace.git",
    "directory": "clients/n8n-nodes-latence-trace"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/nodes/LatenceTrace/LatenceTrace.node.js",
  "scripts": {
    "build": "tsc && cp nodes/LatenceTrace/latence.svg dist/nodes/LatenceTrace/latence.svg",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write '**/*.{ts,json,md}'",
    "test": "node --test dist/test"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LatenceTraceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LatenceTrace/LatenceTrace.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.70.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
