# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.coverage
.coverage.*
.eggs/
.mypy_cache/
.pytest_cache/
.env
.venv
env/
venv/
ENV/
build/
dist/
htmlcov/
pip-wheel-metadata/
site/
*.egg-info/

# Bench data and large checked-out corpora
research/triangular_maxsim/external_data/
data/
# Live-endpoint benchmark outputs (scripts/bench_runpod_360.py --dump)
reports/
docs/core_freeze/*_report.json
docs/core_freeze/*_report.jsonl
docs/core_freeze/*_local.json
docs/core_freeze/*_live.json
# Re-allow the small calibration / fusion artefacts that the runtime
# loads via PROFILE_ENV_PRESETS - these are tiny JSON files, not corpora.
!latence_trace/data/
!latence_trace/data/*.json

# Heavy artefacts (allow only the small in-repo encoder fixtures explicitly)
*.pt
!research/triangular_maxsim/embeddings__*.pt
*.bin
*.zst

# Logs and IDE
*.log
.trace-sessions/
.idea/
.vscode/
wandb/

# Web/gateway local output
gateway/cloudflare/.wrangler/
gateway/cloudflare/node_modules/

# Local model and dataset caches
**/model_cache/
datasets/
research/trace_memory/**/artifacts/*.jsonl

# OS
.DS_Store
